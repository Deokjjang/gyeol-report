          "personB:mbti:ESFJ:traits:relationships:small_talk_bonding:plainKo"
        ],
        "nodeIds": [
          "mbti:INTP:traits:child:socially_detached_child:plainKo",
          "mbti:INTP:traits:relationships:low_need_for_human_ties:plainKo",
          "mbti:INTP:traits:relationships:quiet_cutoff_pattern:plainKo",
          "mbti:ESFJ:traits:relationships:conservative_partner_preference:plainKo",
          "mbti:ESFJ:traits:relationships:inclusion_drive:plainKo",
          "mbti:ESFJ:traits:relationships:small_talk_bonding:plainKo"
        ]
      },
      {
        "chapterId": "CH07",
        "paragraphId": "CH07.P1",
        "role": "S3",
        "text": "소연님에게는 다른 방향도 있습니다: 좋은 일이 생기면 혼자 끝내기보다 누군가와 함께 나누고 싶어 합니다.",
        "sourceRefs": [
          "personA:mbti:INTP:traits:child:socially_detached_child:plainKo",
          "personA:mbti:INTP:traits:relationships:low_need_for_human_ties:plainKo",
