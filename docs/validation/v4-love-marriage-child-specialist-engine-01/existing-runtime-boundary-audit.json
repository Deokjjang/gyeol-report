  "callPath": {
    "A": "runtimeShadow -> buildV4LoveProduct -> composeLoveNarrative and buildRelationshipProfiles",
    "B": "existing individual calculation -> Myeongli -> MBTI source -> Fusion -> Claim -> Resonance -> Contextual Guidance",
    "C": "projectRelationshipView retains existing relationship domains and axes",
    "D": "selectLoveProductSources: L1/L3/L4/L5/L6/L7/L8/L9; L2 no direct take",
    "E": "attraction/partner use retained legacy and Release sources; withoutPair strips direct Pair references",
    "F": "loveContext/ReleaseContext use entered relationshipStatus without changing individual core",
    "G": "CH08 own PARENTS exception, not CHILD/CHILDREN source transfer",
    "H": "Release Renderer CH01-09 separately defined from L questions",
    "I": "Validator hardErrors, required sections and reviewNarrative determine existing Release/fallback",
    "J": "Quality Issues are not new payment errors",
    "K": "Reader-L/Canonical-Atom/Research-Release facet bridges UNVERIFIED",
    "L": "No Writer, existing generator or runtime modification"
  },
  "releaseReuse": {
    "nonRecallEligibility": "usedFacet < 6",
    "recallGlobalFacetException": true,
    "sameChapterFacetGuardAlsoForRecall": true,
    "rootUse": "sorting, no hard cap",
    "LSelectorTheme": "duplicateGroupId ?? semanticOverlapGroup ?? semanticTheme; unique per selector run"
  }
}
