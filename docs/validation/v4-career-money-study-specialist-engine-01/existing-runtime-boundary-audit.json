  "callPath": {
    "A": "runtimeShadow -> buildV4CareerProduct -> integrated Myeongli/MBTI/Fusion/Claim/Resonance/Guidance; no job text in core semantic calculations",
    "B": "selectCareerProductSources reuses collectComprehensiveCandidates normalization, not Comprehensive scheduler",
    "C": "take calls K1-K7; K8/K9 are adapter integration labels, not new selection/ranking; K10 uses operating guidance",
    "D": "careerRecommendations -> unchanged 8 CAREER_ROUTES -> existing significance ordering/top-three/sparse fallback; adapter may append grounded rationale without reordering",
    "E": "existing chosen routes/MBTI avoid hints -> avoidEnvironments; unresolved trait hints not repaired",
    "F": "narrativeContext -> careerContextV3/workManifestation -> careerWorkNarrative existing overrides",
    "G": "renderCareerRelease -> CH01-CH09 / existing materials/apps/context/study; CH03 uses legacy recommendation proof",
    "H": "validateCareerRelease retains hardErrors and qualityIssues separately; length/quality issues are not new payment gates",
    "I": "Adapter publishes release only if original hard errors/opening/required sections pass; otherwise existing legacy edition"
  },
  "readerBridge": "READER_INTERNAL_QUESTION_BRIDGE_UNVERIFIED",
  "reuseUnits": "Release positive facet cap 4; risk/recall exempt from global positive cap; risk exemption in chapter guard; root atom uses sorted by count, not hard capped; Canonical Fact Root bridge unverified",
